generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SchoolYear {
  id        String   @id @default(uuid())
  label     String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
}

model Grade {
  id        String   @id @default(uuid())
  name      String   @unique
  level     Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
}

model Section {
  id           String @id @default(uuid())
  name         String
  gradeId      String
  schoolYearId String

  grade      Grade      @relation(fields: [gradeId], references: [id])
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, gradeId, schoolYearId])
  @@index([gradeId])
  @@index([schoolYearId])
}
