// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SchoolYear {
  id       String  @id @default(uuid())
  label    String  @unique
  isActive Boolean @default(false)

  sections    Section[]
  enrollments Enrollment[]
  importJobs  ImportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        String   @id @default(uuid())
  name      String   @unique
  level     Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
}

model Section {
  id           String @id @default(uuid())
  name         String
  gradeId      String
  schoolYearId String

  grade      Grade      @relation(fields: [gradeId], references: [id])
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, gradeId, schoolYearId])
  @@index([gradeId])
  @@index([schoolYearId])
}

model Student {
  id  String  @id @default(uuid())
  lrn String? @unique

  firstName  String
  middleName String?
  lastName   String
  suffix     String?

  birthday   DateTime?
  birthplace String?
  address    String?

  fatherName    String?
  motherName    String?
  guardianName  String?
  contactNumber String?

  remarks String?

  archivedAt DateTime?

  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id           String @id @default(uuid())
  studentId    String
  sectionId    String
  schoolYearId String

  status       String   @default("ACTIVE")
  dateEnrolled DateTime @default(now())

  student    Student    @relation(fields: [studentId], references: [id])
  section    Section    @relation(fields: [sectionId], references: [id])
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, schoolYearId])
  @@index([sectionId])
  @@index([schoolYearId])
}

model ImportJob {
  id String @id @default(uuid())

  target String

  fileName  String
  fileType  String
  fileSize  Int?
  sheetName String?

  schoolYearId String?
  schoolYear   SchoolYear? @relation(fields: [schoolYearId], references: [id])

  status String @default("UPLOADED")

  mappingConfig       Json?
  normalizationConfig Json?

  totalRows    Int @default(0)
  validRows    Int @default(0)
  warningRows  Int @default(0)
  errorRows    Int @default(0)
  importedRows Int @default(0)

  issues ImportIssue[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([target])
  @@index([status])
  @@index([schoolYearId])
}

model ImportIssue {
  id String @id @default(uuid())

  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  rowNumber Int

  sourceColumn String?
  targetField  String?

  severity String
  code     String
  message  String

  originalValue   String?
  normalizedValue String?

  resolved Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([importJobId])
  @@index([severity])
  @@index([resolved])
}

enum UserRole {
  TEACHER
  SUPER_ADMIN
}

model User {
  id             String   @id @default(uuid())
  supabaseUserId String   @unique
  email          String   @unique
  role           UserRole @default(TEACHER)
  isActive       Boolean  @default(true)

  teacher Teacher?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

enum TeacherStationStatus {
  OWN_STATION
  REASSIGNED
  BORROWED
  CLUSTERED
}

model Teacher {
  id     String  @id @default(uuid())
  userId String? @unique

  firstName   String
  middleName  String?
  lastName    String
  suffix      String?
  gender      String?
  birthday    DateTime?
  civilStatus String?

  employeeNumber String                @unique
  designation    String
  stationStatus  TeacherStationStatus?

  degreeFinished      String?
  prcSpecialization   String?
  minorSpecialization String?
  postGraduateDegree  String?

  originalAppointmentDate DateTime?
  stationStartDate        DateTime?

  cellphoneNumber  String?
  personalEmail    String?
  depEdEmail       String?
  office365Account String?
  r4a3Account      String?

  province String?
  town     String?
  barangay String?
  street   String?

  archivedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([designation])
  @@index([archivedAt])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccessRequest {
  id        String              @id @default(uuid())
  fullName  String
  email     String              @unique
  status    AccessRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}
